<div class="card">
    <div class="card-header justify-content-between">
        <h5 class="card-title"> Recent Transactions</h5>

    </div>

    <div class="card-body">

          <!-- Pagination Top -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted">
                Showing page @Model.transactions.Page of @totalPages
            </span>

            <nav>
                <ul class="pagination mb-0">

                    <!-- Previous -->
                    <li class="page-item @(Model.transactions.Page <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="?page=@(Model.transactions.Page - 1)&pageSize=@Model.transactions.PageSize">
                            Previous
                        </a>
                    </li>

                    <!-- Page Numbers -->
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == Model.transactions.Page ? "active" : "")">
                            <a class="page-link" href="?page=@p&pageSize=@Model.transactions.PageSize">@p</a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(Model.transactions.Page >= totalPages ? "disabled" : "")">
                        <a class="page-link"
                           href="?page=@(Model.transactions.Page + 1)&pageSize=@Model.transactions.PageSize">
                            Next
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
        <!-- End Pagination Top -->


        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="align-middle thead-sm">
                    <tr class="text-uppercase fs-xxs">
                        <th>#</th>
                        <th>MID</th>
                        <th>BrandName</th>
                        <th>Phone</th>
                        <th>Message</th>
                        <th>Operator</th>
                        <th>Type</th>
                        <th>Provider</th>
                        <th>Sent At</th>
                        <th>Status</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.transactions.Items)
                    {
                        <tr>
                            <td>@index</td>
                            <td>@u.transaction_id</td>
                            <td>@u.brand_name</td>
                            <td>@u.phone</td>

                            
                            <td>
                                <div class="d-flex justify-content-center align-items-center">
                                    <span id="messageContent-@index">********</span>

                                    @if (u.hasPassphrase)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-view ms-2"
                                                data-bs-toggle="modal"
                                                data-bs-target="#checkModal"
                                                data-encrypted="@u.encryptedMessage"
                                                data-wrapped-dek="@u.wrappedDek"
                                                data-dek-salt="@u.dekSalt"
                                                data-dek-iv="@u.dekIv"
                                                data-id="messageContent-@index">
                                            <i data-lucide="eye-off"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2" title="No passphrase configured">
                                            <i data-lucide="lock"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(u.operator_name)
                                                            ? ""
                                                            : u.operator_name.Split('_')[0])
                            </td>
                            <td>@u.sms_type</td>

                            <td>
                                <span class="badge badge-label rounded-1 @(u.provider_name == "mytel" ? "bg-warning" : u.provider_name == "atom" ? "bg-info" : u.provider_name == "u9" ? "bg-danger" : "bg-secondary")">
                                    @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(u.provider_name.ToLower())
                                </span>

                            </td>
                            <td>@u.sent_at</td>
                            <td>
                                <span class="badge badge-label rounded-1 @(u.status == "SUCCESS" ? "bg-success" : u.status == "INVALID" ? "bg-danger" : u.status == "INSUFFICIENT" ? "bg-warning" : "bg-primary")">
                                    @u.status
                                </span>

                            </td>

                        </tr>
                        index++;
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>


<div class="modal fade" id="checkModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Enter Passphrase to Decrypt</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="decryptAllCheck">
                    <label class="form-check-label" for="decryptAllCheck">
                        Decrypt all visible messages
                    </label>
                </div>

                <input id="passwordInput"
                       type="password"
                       class="form-control"
                       placeholder="Enter passphrase">

                <small id="errorText"
                       class="text-danger d-none">
                    Invalid passphrase or decryption failed
                </small>

                <div id="decryptSpinner" class="text-center mt-2 d-none">
                    <div class="spinner-border spinner-border-sm" role="status">
                        <span class="visually-hidden">Decrypting...</span>
                    </div>
                    <small class="ms-1">Deriving key...</small>
                </div>
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">
                    Close
                </button>
                <button class="btn btn-primary" id="btnCheck">
                    Decrypt
                </button>
            </div>

        </div>
    </div>
</div>

<script src="~/js/axpigeon-crypto.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        let currentBtn = null;

        document.querySelectorAll(".btn-view").forEach(btn => {
            btn.addEventListener("click", function () {
                currentBtn = this;
                document.getElementById("passwordInput").value = "";
                document.getElementById("errorText").classList.add("d-none");
                document.getElementById("decryptSpinner").classList.add("d-none");
            });
        });

        document.getElementById("btnCheck").addEventListener("click", async function () {
            const passphrase = document.getElementById("passwordInput").value;
            if (!passphrase) return;

            const spinner = document.getElementById("decryptSpinner");
            const errorText = document.getElementById("errorText");
            const btnCheck = this;

            spinner.classList.remove("d-none");
            errorText.classList.add("d-none");
            btnCheck.disabled = true;

            const decryptAll = document.getElementById("decryptAllCheck").checked;

            try {
                if (decryptAll) {
                    const buttons = document.querySelectorAll(".btn-view");
                    for (const btn of buttons) {
                        const enc = btn.dataset.encrypted;
                        const wdek = btn.dataset.wrappedDek;
                        const salt = btn.dataset.dekSalt;
                        const iv = btn.dataset.dekIv;
                        const spanId = btn.dataset.id;

                        if (!enc || !wdek || !salt || !iv) continue;

                        try {
                            const plaintext = await AxpigeonCrypto.decryptWithCache(
                                passphrase, wdek, salt, iv, enc
                            );
                            document.getElementById(spanId).innerText = plaintext;
                        } catch (e) {
                            // skip rows that fail (different branch/passphrase)
                        }
                    }

                    bootstrap.Modal.getInstance(
                        document.getElementById("checkModal")
                    ).hide();
                } else {
                    const enc = currentBtn.dataset.encrypted;
                    const wdek = currentBtn.dataset.wrappedDek;
                    const salt = currentBtn.dataset.dekSalt;
                    const iv = currentBtn.dataset.dekIv;
                    const spanId = currentBtn.dataset.id;

                    const plaintext = await AxpigeonCrypto.decryptWithCache(
                        passphrase, wdek, salt, iv, enc
                    );

                    document.getElementById(spanId).innerText = plaintext;

                    bootstrap.Modal.getInstance(
                        document.getElementById("checkModal")
                    ).hide();
                }
            } catch (e) {
                errorText.classList.remove("d-none");
            } finally {
                spinner.classList.add("d-none");
                btnCheck.disabled = false;
            }
        });
    });
</script>
