@using AxpigeonApp.Dao
@model ScheduledSmsResponseDao

@{
    ViewData["Title"] = "Schedule Detail";
    var data = Model.data;
    var isPending = data?.scheduleStatus == "PENDING";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="/ScheduledSms">Scheduled SMS</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detail</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (data != null)
{
    <!-- Schedule Info Card -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Schedule Information</h5>
            @if (isPending)
            {
                <button type="button" class="btn btn-danger btn-sm"
                        data-bs-toggle="modal" data-bs-target="#cancelModal">
                    Cancel Schedule
                </button>
            }
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted" style="width:40%">Schedule ID</td>
                                <td><code>@data.scheduleId</code></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Brand</td>
                                <td>@data.brandName</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">SMS Type</td>
                                <td>
                                    <span class="badge badge-label rounded-1 @(data.smsType == "BULK" ? "bg-info" : "bg-primary")">
                                        @data.smsType
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Sender ID</td>
                                <td>@data.senderId</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted" style="width:40%">Status</td>
                                <td>
                                    <span class="badge badge-label rounded-1 @GetStatusBadgeClass(data.scheduleStatus)">
                                        @data.scheduleStatus
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Scheduled At</td>
                                <td>@FormatDateTime(data.scheduledAt)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Created At</td>
                                <td>@FormatDateTime(data.createdAt)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted">Updated At</td>
                                <td>@FormatDateTime(data.updatedAt)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Counts Summary -->
            <div class="row mt-3">
                <div class="col-md-3 col-sm-6 mb-2">
                    <div class="border rounded-3 p-3 text-center">
                        <h4 class="mb-1">@data.totalRecipients</h4>
                        <span class="text-muted">Total</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-2">
                    <div class="border rounded-3 p-3 text-center">
                        <h4 class="mb-1 text-success">@data.sentCount</h4>
                        <span class="text-muted">Sent</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-2">
                    <div class="border rounded-3 p-3 text-center">
                        <h4 class="mb-1 text-danger">@data.failedCount</h4>
                        <span class="text-muted">Failed</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6 mb-2">
                    <div class="border rounded-3 p-3 text-center">
                        <h4 class="mb-1 text-warning">@data.pendingCount</h4>
                        <span class="text-muted">Pending</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recipients Table -->
    @if (data.recipients != null && data.recipients.Count > 0)
    {
        <div class="card mt-3">
            <div class="card-header">
                <h5 class="card-title mb-0">Recipients (@data.recipients.Count)</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="align-middle thead-sm">
                            <tr class="text-uppercase fs-xxs">
                                <th>#</th>
                                <th>Phone</th>
                                <th>Operator</th>
                                <th>Status</th>
                                <th>Sent At</th>
                                <th>Error</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rIndex = 1; }
                            @foreach (var recipient in data.recipients)
                            {
                                <tr>
                                    <td>@rIndex</td>
                                    <td>@recipient.phone</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(recipient.operatorName))
                                        {
                                            @recipient.operatorName.Split('_')[0]
                                        }
                                    </td>
                                    <td>
                                        <span class="badge badge-label rounded-1 @GetStatusBadgeClass(recipient.status)">
                                            @recipient.status
                                        </span>
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(recipient.sentAt) ? "-" : FormatDateTime(recipient.sentAt))</td>
                                    <td>@(string.IsNullOrWhiteSpace(recipient.errorMessage) ? "-" : recipient.errorMessage)</td>
                                </tr>
                                rIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Cancel Modal -->
    @if (isPending)
    {
        <div class="modal fade" id="cancelModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" action="/ScheduledSms/Cancel/@data.scheduleId">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Cancel Schedule</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>Are you sure you want to cancel this scheduled SMS?</p>
                            <div class="form-floating mb-3">
                                <textarea class="form-control" name="reason"
                                          style="height:80px" placeholder="Reason"></textarea>
                                <label>Reason (optional)</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger">Confirm Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-warning">Schedule data not found.</div>
}

@functions {
    string GetStatusBadgeClass(string status) => status switch
    {
        "PENDING" => "bg-warning",
        "PROCESSING" => "bg-info",
        "COMPLETED" => "bg-success",
        "SENT" => "bg-success",
        "FAILED" => "bg-danger",
        "CANCELLED" => "bg-secondary",
        _ => "bg-primary"
    };

    string FormatDateTime(string dateStr)
    {
        if (string.IsNullOrWhiteSpace(dateStr)) return "-";
        if (DateTime.TryParse(dateStr, out var dt))
            return dt.ToString("yyyy-MM-dd HH:mm");
        return dateStr;
    }
}
