@{
    ViewData["Title"] = "Signin";
    Layout = "_AuthLayout";
}
<div class="row justify-content-center">
    <div class="col-xxl-4 col-md-6 col-sm-8">
        <div class="card">
            <div class="card-body">
                <div class="auth-brand mb-4">
                    <a href="index.html" class="logo-dark">
                        <span class="d-flex align-items-center justify-content-center gap-1">
                            <img src="~/images/axpigeon.png" height="100" alt="Logo">
                            @* <span class="logo-text text-body fw-bold fs-xl">Axpigeon</span> *@
                        </span>
                    </a>
                    <a href="index.html" class="logo-light">
                        <span class="d-flex align-items-center justify-content-center gap-1">
                            <img src="~/images/axpigeon.png" height="100" alt="Logo">
                            @* <span class="logo-text text-white fw-bold fs-xl">Axpigeon</span> *@
                        </span>
                    </a>
                    <p class="text-muted w-lg-75 mt-3">Let’s get you signed in. Enter your email and password to continue.</p>
                </div>
                @if (ViewData["Error"] != null)
                {
                    <div class="alert alert-danger mt-2">
                        @ViewData["Error"]
                    </div>
                }

                <div class="">
                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="userEmail" class="form-label">Email address <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="email" class="form-control" id="userEmail" name="email" placeholder="you@example.com" required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="userPassword" class="form-label">Password <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="password" class="form-control"  id="userPassword" name="password" placeholder="password" required>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary fw-semibold py-2">Sign In</button>
                        </div>
                    </form>


                </div>
            </div>
        </div>
        <p class="text-center text-muted mt-4 mb-0">
            © <script>document.write(new Date().getFullYear())</script> Powered by <span class="fw-semibold">AXRA TECH</span>
        </p>
    </div>
</div>

